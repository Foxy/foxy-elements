# Copy to .env and fill in. Every .env* file except this one is gitignored.
#
# Variables prefixed with VITE_ are inlined into the client bundle and are
# readable by anyone loading the page: keep secrets out of them. Vite reads env
# files at startup, so restart Storybook or the dev server after editing.

# --- Required -----------------------------------------------------------------
# Both vitest projects fail at import time without VITE_EMBED_ORIGIN.

VITE_EMBED_ORIGIN=https://embed.foxy.io
VITE_FOXYCART_DOMAIN=foxycart.com
VITE_STRIPE_DEMO_PUBLISHABLE_KEY=pk_test_replace_me

# --- Stripe (optional) --------------------------------------------------------
# Preferred over VITE_STRIPE_DEMO_PUBLISHABLE_KEY when set.

# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Klarna (optional) --------------------------------------------------------
# `npm run init:klarna` exchanges these for a sandbox session and writes the
# encoded response to .env.local as VITE_KLARNA_INIT_RESPONSE. There is no
# bundled fallback, so Klarna renders no option until you run it.

# KLARNA_USERNAME=
# KLARNA_PASSWORD=
# KLARNA_API_URL=https://api.playground.klarna.com
# KLARNA_MERCHANT_URL_AUTHORIZATION=https://example.com/checkout/klarna/authorization
# KLARNA_ORDER_AMOUNT=
# KLARNA_ORDER_TAX_AMOUNT=

# --- Square (optional) --------------------------------------------------------
# Client-safe credentials from the Square Developer Dashboard.

# VITE_SQUARE_APP_ID=sandbox-sq0idb-replace_me
# VITE_SQUARE_LOCATION_ID=
# VITE_SQUARE_ENVIRONMENT=sandbox

# --- Adyen (optional) ---------------------------------------------------------
# `npm run init:adyen` writes a VITE_ADYEN_PAYMENT_METHODS_RESPONSE_<COUNTRY>
# per market. See examples/default/adyen_embedded/README.md.

# ADYEN_API_KEY=
# ADYEN_MERCHANT_ACCOUNT=
# ADYEN_SHOPPER_EMAIL=
# ADYEN_RETURN_URL_BASE=
# VITE_ADYEN_ENVIRONMENT=test
# VITE_ADYEN_CLIENT_KEY=

# --- PayPal (optional) --------------------------------------------------------
# One client id and secret per buyer country; `npm run init:paypal` writes a
# VITE_PAYPAL_SANDBOX_ORDER_ID_<COUNTRY> for each. Supported: US, BE, NL, AT, PL.
# See examples/default/paypal_platform/README.md.

# VITE_PAYPAL_SANDBOX_CLIENT_ID_US=
# PAYPAL_SANDBOX_CLIENT_SECRET_US=

# --- Sezzle (optional) --------------------------------------------------------

# SEZZLE_PUBLIC_KEY=
# SEZZLE_PRIVATE_KEY=
# VITE_SEZZLE_PUBLIC_KEY=
# VITE_SEZZLE_CHECKOUT_URL=
