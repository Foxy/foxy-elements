{
  "name": "@foxy.io/elements",
  "type": "module",
  "version": "0.0.0",
  "description": "Embeddable e-commerce web components by Foxy.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Foxy/foxy-elements.git"
  },
  "license": "MIT",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "module": "./dist/npm/index.js",
  "types": "./dist/npm/index.d.ts",
  "exports": {
    ".": "./dist/npm/index.js",
    "./foxy-ach-field": "./dist/npm/foxy-ach-field.js",
    "./foxy-express-checkout": "./dist/npm/foxy-express-checkout.js",
    "./foxy-payment-card-field": "./dist/npm/foxy-payment-card-field.js",
    "./foxy-payment-method-selector": "./dist/npm/foxy-payment-method-selector.js"
  },
  "scripts": {
    "extract": "formatjs extract 'src/**/*.ts*' --ignore='**/*.d.ts' --out-file src/locales/en-US.json --id-interpolation-pattern '[sha512:contenthash:base64:6]' --format simple",
    "init:adyen": "node ./scripts/init-adyen-payment-methods.js",
    "init:klarna": "node ./scripts/init-klarna-session.js",
    "init:paypal": "node ./scripts/init-paypal-order.js",
    "init:sezzle": "node ./scripts/init-sezzle-session.js",
    "localdev:storybook": "storybook dev -p 6006 --no-open",
    "localdev:examples": "caddy start && vite --port 6007 --no-open",
    "build:npm": "tsc -b && vite build",
    "build:cdn": "tsc -b && vite build --mode=cdn",
    "build:storybook": "storybook build",
    "prepack": "npm run build:npm"
  },
  "dependencies": {
    "@google-pay/button-element": "^3.2.1",
    "@stripe/react-stripe-js": "^6.0.0",
    "@stripe/stripe-js": "^9.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.536.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intl": "^7.1.11",
    "react-svg-credit-card-payment-icons": "^5.1.2",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "@foxy.io/design-system": "0.0.0",
    "@foxy.io/sdk": "file:foxy.io-sdk-0.0.0.tgz"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@eslint/js": "^9.30.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@formatjs/cli": "^6.7.2",
    "@foxy.io/design-system": "file:foxy.io-design-system-0.0.0.tgz",
    "@foxy.io/sdk": "file:foxy.io-sdk-0.0.0.tgz",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/web-components-vite": "^10.3.5",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser": "^4.1.4",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^10.3.5",
    "globals": "^16.3.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^8.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-external": "^6.2.2",
    "vitest": "^4.1.4"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successComment": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
